generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum VehicleCondition {
  NEW
  USED
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id           String           @id @default(cuid())
  slug         String           @unique
  make         String
  model        String
  year         Int
  price        Decimal          @db.Decimal(12, 2)
  mileage      Int?
  condition    VehicleCondition @default(USED)
  bodyType     String?
  fuelType     String?
  transmission String?
  driveType    String?
  color        String?
  description  String?
  featured     Boolean          @default(false)
  status       VehicleStatus    @default(AVAILABLE)

  images VehicleImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([make])
  @@index([year])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  publicId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Review {
  id           String   @id @default(cuid())
  customerName String
  rating       Int
  comment      String
  image        String?
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([published])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published])
  @@index([publishedAt])
}

model SiteSettings {
  id           String   @id @default(cuid())
  businessName String   @default("Doctor's Autos")
  tagline      String?
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  instagram    String?
  facebook     String?
  logo         String?
  updatedAt    DateTime @updatedAt
}


model PendingCloudinaryDeletion {
  id            String   @id @default(cuid())
  publicId      String   @unique
  attempts      Int      @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

